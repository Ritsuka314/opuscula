<% layout("./base") -%>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><%= it.site.hero.eyebrow %></p>
        <h1 lang="zh-Hant">
          <span><%= it.site.hero.titleLead %></span>
          <span class="hero-emphasis"><%= it.site.hero.titleEmphasis %></span>
        </h1>
        <p class="hero-intro" lang="zh-Hant"><%= it.site.hero.introduction %></p>
        <a class="text-link" href="#writings"><%= it.site.hero.browseLabel %> <span aria-hidden="true">↓</span></a>
      </div>
      <aside class="hero-title-slip" aria-label="<%= it.site.nameCjk %>, by <%= it.site.ownerCjk %>">
        <span class="slip-title" lang="zh-Hant"><%= it.site.nameCjk %></span>
        <span class="slip-owner" lang="zh-Hant"><%= it.site.ownerCjk %></span>
      </aside>
    </section>

    <section class="section writings" id="writings">
      <header class="section-heading">
        <p class="eyebrow" lang="zh-Hant"><%= it.site.catalogue.eyebrow %></p>
        <h2><%= it.site.catalogue.title %></h2>
        <p><%= it.site.catalogue.description %></p>
      </header>

<% it.writings.forEach((writing) => { -%>
      <article class="writing-card">
        <div class="writing-number" aria-label="Writing number <%= Number(writing.number) %>"><%= writing.number %></div>
        <div class="writing-main">
          <p class="writing-meta"><%= writing.category %> / <%= writing.kind %></p>
          <h3><a href="<%= writing.slug %>/"><%= writing.title %></a></h3>
<% if (writing.subtitle) { -%>
          <p class="writing-subtitle"<% if (writing.subtitle.lang) { %> lang="<%= writing.subtitle.lang %>"<% } %>><%= writing.subtitle.text %></p>
<% } -%>
          <p class="writing-summary">
            <%= writing.summary %>
          </p>
          <div class="writing-links">
<% writing.cardActions.forEach((action) => { -%>
            <a class="action-link action-<%= action.kind %>" href="<%= writing.slug %>/<%= action.href %>"><%= action.label %></a>
<% }) -%>
          </div>
        </div>
<% if (writing.motif) { -%>
        <div class="writing-motif" aria-hidden="true">
          <span><%= writing.motif.left %></span>
          <span class="motif-arrow"><%= writing.motif.arrow %></span>
          <span><%= writing.motif.right %></span>
        </div>
<% } -%>
      </article>
<% }) -%>
    </section>

    <section class="section about" id="about">
      <div>
        <p class="eyebrow" lang="zh-Hant"><%= it.site.about.eyebrow %></p>
        <h2 lang="zh-Hant"><%= it.site.about.title %></h2>
      </div>
      <div class="about-copy" lang="zh-Hant">
<% it.site.about.paragraphs.forEach((paragraph) => { -%>
        <p>
          <%~ paragraph %>
        </p>
<% }) -%>
      </div>
    </section>
  </main>
